# --- Django ----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=a-remplacer-par-une-valeur-aleatoire-de-50-caracteres
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# --- Base de donnees -------------------------------------------------------
POSTGRES_DB=dpfc
POSTGRES_USER=dpfc
POSTGRES_PASSWORD=dpfc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Taches de fond --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Stockage objet (MinIO en developpement) -------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio-dpfc
S3_SECRET_KEY=minio-dpfc-secret
S3_BUCKET=dpfc
S3_REGION=us-east-1

# --- Courriel --------------------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=portail@dpfc.education.ci

# --- Securite --------------------------------------------------------------
AXES_ENABLED=0
AXES_FAILURE_LIMIT=8
