# /etc/systemd/system/dpfc.service
[Unit]
Description=Portail DPFC (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/dpfc
EnvironmentFile=/var/www/dpfc/.env
ExecStart=/var/www/dpfc/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 --bind unix:/run/dpfc.sock --timeout 120 --access-logfile -
Restart=always

[Install]
WantedBy=multi-user.target
